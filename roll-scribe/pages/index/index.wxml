<view class="container">
  <!-- 第一步：设置人数和昵称 -->
  <block wx:if="{{stage === 'setup'}}">
    <view class="card">
      <view class="label">参与人数（{{minPlayers}} ~ {{maxPlayers}} 人）</view>
      <view class="stepper big">
        <view class="step-btn {{playerCount <= minPlayers ? 'disabled' : ''}}" bindtap="decreasePlayers">-</view>
        <view class="step-value">{{playerCount}}</view>
        <view class="step-btn {{playerCount >= maxPlayers ? 'disabled' : ''}}" bindtap="increasePlayers">+</view>
      </view>
    </view>

    <view class="card">
      <view class="label">昵称（选填，不填按序号命名）</view>
      <input
        class="name-input"
        wx:for="{{names}}"
        wx:key="index"
        value="{{item}}"
        maxlength="{{nameMaxLength}}"
        placeholder="玩家{{index + 1}}"
        data-index="{{index}}"
        bindinput="onNameInput"
      />
    </view>

    <button class="primary-btn" bindtap="startPlay">开始</button>
  </block>

  <!-- 第二步：每人一个投掷按钮 -->
  <block wx:else>
    <view class="toolbar card">
      <view class="label">每次投掷</view>
      <view class="stepper">
        <view class="step-btn {{count <= minCount ? 'disabled' : ''}}" bindtap="decrease">-</view>
        <view class="step-value">{{count}}D6</view>
        <view class="step-btn {{count >= maxCount ? 'disabled' : ''}}" bindtap="increase">+</view>
      </view>
      <view class="link" bindtap="backToSetup">重设人数</view>
    </view>

    <view class="stage card">
      <canvas type="webgl" id="dice3d" class="dice-canvas"></canvas>
      <view class="result-line">
        <block wx:if="{{rollingName}}">{{rollingName}} 投掷中…</block>
        <block wx:elif="{{result}}">
          <text class="result-name">{{result.name}}</text>
          <text class="label"> {{result.count}}D6 [{{result.valuesText}}] · {{result.timeText}}</text>
          <view>总和：<text class="total-num">{{result.total}}</text></view>
        </block>
        <block wx:else><text class="label">点击下方玩家按钮投掷</text></block>
      </view>
    </view>

    <view class="player-grid">
      <view
        class="player-btn {{players.length === 1 ? 'full' : ''}} {{rollingName ? 'disabled' : ''}} {{rollingName === item.name ? 'active' : ''}}"
        wx:for="{{players}}"
        wx:key="name"
        data-name="{{item.name}}"
        bindtap="onRoll"
      >
        <view class="player-name">{{item.name}}</view>
        <view class="player-last">{{item.last || '点击投掷'}}</view>
      </view>
    </view>

    <view class="history-entry" bindtap="goHistory">查看历史记录</view>
  </block>
</view>
