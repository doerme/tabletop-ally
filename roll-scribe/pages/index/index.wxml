<view class="container {{stage === 'play' ? 'play-container' : ''}}">
  <!-- 第一步：设置人数和昵称 -->
  <block wx:if="{{stage === 'setup'}}">
    <view class="card">
      <view class="label">参与人数（{{minPlayers}} ~ {{maxPlayers}} 人）</view>
      <view class="stepper big">
        <view class="step-btn {{playerCount <= minPlayers ? 'disabled' : ''}}" bindtap="decreasePlayers">-</view>
        <view class="step-value">{{playerCount}}</view>
        <view class="step-btn {{playerCount >= maxPlayers ? 'disabled' : ''}}" bindtap="increasePlayers">+</view>
      </view>
    </view>

    <view class="card">
      <view class="label">昵称（选填，不填按序号命名）</view>
      <input
        class="name-input"
        wx:for="{{names}}"
        wx:key="index"
        value="{{item}}"
        maxlength="{{nameMaxLength}}"
        placeholder="玩家{{index + 1}}"
        data-index="{{index}}"
        bindinput="onNameInput"
      />
    </view>

    <button class="primary-btn" bindtap="startPlay">开始</button>
  </block>

  <!-- 第二步：每人一个投掷按钮 -->
  <block wx:else>
    <view class="toolbar card">
      <view class="label">每次投掷</view>
      <view class="stepper">
        <view class="step-btn {{count <= minCount ? 'disabled' : ''}}" bindtap="decrease">-</view>
        <view class="step-value">{{count}}D6</view>
        <view class="step-btn {{count >= maxCount ? 'disabled' : ''}}" bindtap="increase">+</view>
      </view>
      <view class="link" bindtap="backToSetup">重设人数</view>
    </view>

    <view class="stage card">
      <canvas type="webgl" id="dice3d" class="dice-canvas"></canvas>
      <view class="result-line">
        <view class="result-info">
          <block wx:if="{{rollingName}}">{{rollingName}} 投掷中…</block>
          <block wx:elif="{{result}}">
            <text class="result-name">{{result.name}}</text>
            <text class="label"> {{result.count}}D6 [{{result.valuesText}}] · {{result.timeText}}</text>
          </block>
          <block wx:else><text class="label">点击下方玩家按钮投掷</text></block>
        </view>
        <view class="result-total {{!result || rollingName ? 'result-placeholder' : ''}}">总和：<text class="total-num">{{result ? result.total : '—'}}</text></view>
      </view>
    </view>

    <view class="player-grid">
      <view
        class="player-card {{players.length === 1 ? 'full' : ''}}"
        wx:for="{{players}}"
        wx:for-item="player"
        wx:for-index="playerIndex"
        wx:key="name"
      >
        <view
          class="player-btn {{rollingName ? 'disabled' : ''}} {{rollingName === player.name ? 'active' : ''}}"
          data-name="{{player.name}}"
          bindtap="onRoll"
        >
          <view class="player-name">{{player.name}}</view>
          <view class="player-last">{{player.last || '点击投掷'}}</view>
        </view>
        <view class="player-counters">
          <view class="counter" wx:for="{{player.counters}}" wx:for-item="counter" wx:key="id">
            <view class="counter-header">
              <input
                class="counter-name"
                value="{{counter.name}}"
                placeholder="计数{{counter.id}}"
                maxlength="20"
                data-player-index="{{playerIndex}}"
                data-counter-id="{{counter.id}}"
                bindinput="onCounterNameInput"
                bindblur="onCounterNameBlur"
              />
              <button
                wx:if="{{player.counters.length > 1}}"
                class="counter-delete"
                data-player-index="{{playerIndex}}"
                data-counter-id="{{counter.id}}"
                bindtap="removeCounter"
              >删除</button>
            </view>
            <view class="counter-stepper">
              <button
                class="counter-step"
                disabled="{{counter.value === 0}}"
                data-player-index="{{playerIndex}}"
                data-counter-id="{{counter.id}}"
                data-delta="-1"
                bindtap="changeCounter"
              >−</button>
              <view class="counter-value">{{counter.value}}</view>
              <button
                class="counter-step"
                data-player-index="{{playerIndex}}"
                data-counter-id="{{counter.id}}"
                data-delta="1"
                bindtap="changeCounter"
              >+</button>
            </view>
          </view>
          <button class="counter-add" data-player-index="{{playerIndex}}" bindtap="addCounter">+ 新增计数框</button>
        </view>
      </view>
    </view>

    <view class="history-entry" bindtap="goHistory">查看历史记录</view>
  </block>
</view>
