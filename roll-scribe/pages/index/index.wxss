.container {
  padding: 32rpx 32rpx 180rpx;
}

.play-container {
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
}

.name-input {
  margin-top: 16rpx;
  height: 88rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper.big {
  margin-top: 20rpx;
  justify-content: space-between;
}

.step-btn {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 40rpx;
  border-radius: 12rpx;
  background: #5b6b7f;
  color: #ffffff;
}

.stepper.big .step-btn {
  width: 120rpx;
  height: 120rpx;
  line-height: 120rpx;
  font-size: 56rpx;
}

.step-btn.disabled {
  opacity: 0.4;
}

.step-value {
  min-width: 120rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
}

.stepper.big .step-value {
  font-size: 72rpx;
}

.primary-btn {
  height: 112rpx;
  line-height: 112rpx;
  font-size: 36rpx;
  background: #5b6b7f !important;
  color: #ffffff !important;
  border-radius: 16rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.toolbar .step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 36rpx;
}

.toolbar .step-value {
  min-width: 96rpx;
  font-size: 32rpx;
}

.link {
  color: #5b6b7f;
  font-size: 28rpx;
}

.stage {
  padding: 0;
  margin-bottom: 16rpx;
  overflow: hidden;
}

.dice-canvas {
  display: block;
  width: 100%;
  height: 200rpx;
}

.result-line {
  min-width: 0;
  box-sizing: border-box;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
  overflow-wrap: break-word;
}

.result-line .label {
  font-size: 24rpx;
}

.result-info {
  height: 64rpx;
  line-height: 32rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.result-total {
  margin-top: 8rpx;
  height: 56rpx;
  line-height: 56rpx;
}

.result-placeholder {
  visibility: hidden;
}

.result-name {
  font-weight: 600;
}

.total-num {
  font-size: 40rpx;
  font-weight: 600;
}

.player-grid {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  justify-content: space-between;
}

.player-card {
  box-sizing: border-box;
  width: calc(50% - 8rpx);
  margin-bottom: 16rpx;
  border: 1rpx solid #e4e9ef;
  border-radius: 16rpx;
  overflow: hidden;
  background: #ffffff;
}

.player-card.full {
  width: 100%;
}

.player-btn {
  box-sizing: border-box;
  min-height: 104rpx;
  padding: 16rpx;
  background: #5b6b7f;
  color: #ffffff;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.player-btn:active {
  background: #4a596b;
}

.player-btn.disabled {
  opacity: 0.5;
}

.player-btn.active {
  opacity: 1;
  background: #3f4d5e;
}

.player-name {
  font-size: 32rpx;
  font-weight: 600;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-last {
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.8;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.player-counters {
  padding: 12rpx;
}

.counter {
  padding: 8rpx 12rpx;
  margin-bottom: 8rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.counter-header {
  display: flex;
  align-items: center;
  margin-bottom: 4rpx;
}

.counter-name {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  font-size: 24rpx;
  color: #3f4d5e;
}

.player-counters .counter-delete,
.player-counters .counter-add,
.player-counters .counter-step {
  box-sizing: border-box;
  min-width: 0;
  padding: 0;
  margin: 0;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.counter-delete::after,
.counter-add::after,
.counter-step::after {
  border: none;
}

.player-counters .counter-delete {
  flex-shrink: 0;
  margin-left: 8rpx;
  width: 60rpx;
  height: 44rpx;
  line-height: 44rpx;
  font-size: 22rpx;
  color: #a34444;
  background: transparent;
}

.counter-stepper {
  display: flex;
  align-items: center;
}

.player-counters .counter-step {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 36rpx;
  background: #5b6b7f;
  color: #ffffff;
}

.player-counters .counter-step[disabled] {
  background: #5b6b7f;
  color: #ffffff;
  opacity: 0.4;
}

.counter-value {
  flex: 1;
  min-width: 0;
  padding: 0 4rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  overflow-wrap: break-word;
}

.player-counters .counter-add {
  width: 100%;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 24rpx;
  color: #5b6b7f;
  background: #eef1f5;
}

.history-entry {
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border: 2rpx solid #5b6b7f;
  border-radius: 12rpx;
  color: #5b6b7f;
  background: #ffffff;
}
